# OpenWeatherMap API Key
# Sign up and obtain a free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Default location when starting the application (e.g., London, New York, Tokyo)
DEFAULT_LOCATION=London

# Optional: Default units (celsius or fahrenheit)
DEFAULT_UNITS=celsius

# Optional: Default theme (light or dark)
DEFAULT_THEME=light

# Optional: Request timeout in seconds
API_TIMEOUT_SECONDS=10
